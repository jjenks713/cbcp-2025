CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
# Local-only secrets — gitignored, never commit this file.

# Used by the React app at runtime (CRA inlines REACT_APP_* vars into the client bundle)
REACT_APP_CONTENTFUL_SPACE_ID=
REACT_APP_CONTENTFUL_ENVIRONMENT=
REACT_APP_CONTENTFUL_DELIVERY_TOKEN=

# Used only by scripts/setup-contentful.js (one-time content model provisioning).
# Deliberately NOT prefixed with REACT_APP_ so it is never bundled into client-side JS —
# this token can create/edit/delete content and must stay server/local-side only.
# Revoke it in Contentful (Settings -> API keys -> Content management tokens) once
# the content types below have been created, or if this file is ever exposed.
CONTENTFUL_CMA_TOKEN=

# EmailJS (contact form) — create a free account at emailjs.com, add
# creepybutcutepress@gmail.com as an Email Service, create a Template with
# {{from_name}}, {{from_email}}, {{message}} variables, then fill these in
# from the EmailJS dashboard (Account -> General for the public key).
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# LaunchDarkly client-side ID (Account settings -> Projects -> your
# environment's "Client-side ID"). Not a secret - it's meant to ship in the
# client bundle - but blank here means the SDK never initializes and every
# flag falls back to its default in src/lib/launchdarkly.ts.
REACT_APP_LAUNCHDARKLY_CLIENT_ID=

# Base URL of the server/ API (see server/.env for its own config). Blank
# here means login/account features are unreachable until set per-environment.
REACT_APP_API_URL=