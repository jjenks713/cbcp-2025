# This file is tracked in git and the repo is public - leave values blank
# here. Put real values in server/.env.local (gitignored) for local dev.
# For the deployed API, supply them as Cloud Run environment variables on
# that service (this is a real backend, unlike the frontend - Cloud Run env
# vars work fine here since nothing needs to be baked in at build time).

PORT=8080

# MongoDB Atlas connection string (Database > Connect > Drivers).
MONGODB_URI=
